# Copy this file to fluent-bit/config.env for local use.
# Never commit a real config.env file; it contains project ingest credentials.

# Log file to tail. Use a platform-specific absolute path on the target host.
APACHE_LOG_PATH=/var/log/apache2/access.log

# Backend ingest API.
BACKEND_URL=http://localhost:8000
API_ENDPOINT=/api/v1/logs/agent/send-logs
API_KEY=replace-with-project-ingest-api-key

# Fluent Bit cursor database path.
FLUENT_BIT_DB_PATH=/var/lib/fluent-bit/logguard-state.db
REFRESH_INTERVAL=5
RETRY_LIMIT=3

# Runtime logging.
LOG_LEVEL=info
DAEMON=off
