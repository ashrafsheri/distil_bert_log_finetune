# LogGuard environment example.
# Copy only the variables needed by the service you are running.
# Never commit real .env files, Firebase service account JSON, API keys, or SMTP credentials.

# Backend: FastAPI control plane
DATABASE_URL=postgresql+asyncpg://logguard_user:logguard_password@localhost:5432/logguard_db
ANOMALY_DETECTION_URL=http://localhost:8001
ELASTICSEARCH_URL=http://localhost:9200
FIREBASE_SERVICE_ACCOUNT_KEY=backend/serviceAccountKey.json
DEFAULT_ADMIN_UID=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_ORG_ID=
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
UVICORN_RELOAD=true
LOG_EVENT_MAX_FUTURE_SECONDS=300
LOG_EVENT_MAX_PAST_SECONDS=604800

# Optional email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
ALERT_COOLDOWN_SECONDS=3600

# Frontend: Vite/React
# Put these in frontend/.env when running the frontend locally.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Anomaly service: realtime_anomaly_detection
HOST=0.0.0.0
PORT=8001
ANOMALY_SERVICE_PORT=8001
RELOAD=false
LOG_LEVEL=info
ADMIN_API_KEY=
MODEL_DIR=artifacts/ensemble_model_export
STORAGE_DIR=data/multi_tenant
ADAPTIVE_STATE_DIR=logs/adaptive_state
WARMUP_THRESHOLD=10000
TEACHER_UPDATE_DAYS=7
DEVICE=cpu
PM_SAVE_INTERVAL=30

# Detector tuning
MULTI_TENANT_SESSION_TTL_SECONDS=1800
MULTI_TENANT_MAX_SESSIONS_PER_PROJECT=50000
MULTI_TENANT_MAX_UNIQUE_PATHS=1000
MULTI_TENANT_SCORE_WINDOW=512
MULTI_TENANT_MIN_OBSERVED_HOURS=6
MULTI_TENANT_MAX_PARSE_FAILURE_RATE=0.05
MULTI_TENANT_MODEL_VERSION=student-teacher-v1
MULTI_TENANT_FEATURE_SCHEMA_VERSION=access-log-v2
MULTI_TENANT_MAX_DAILY_THRESHOLD_DELTA=0.1
MULTI_TENANT_STANDARD_MIN_CALIBRATION_SAMPLES=50
MULTI_TENANT_LOW_TRAFFIC_WARMUP_THRESHOLD=1000
MULTI_TENANT_LOW_TRAFFIC_MIN_TRAINING_SEQUENCES=30
MULTI_TENANT_LOW_TRAFFIC_MIN_IF_FEATURE_ROWS=50
MULTI_TENANT_LOW_TRAFFIC_MIN_OBSERVED_HOURS=3
MULTI_TENANT_LOW_TRAFFIC_MIN_CALIBRATION_SAMPLES=20
MULTI_TENANT_LOW_TRAFFIC_MIN_DISTINCT_TEMPLATES=5
MULTI_TENANT_LOW_TRAFFIC_MAX_TEMPLATE_RATIO=0.95
MULTI_TENANT_RECENT_PARSE_FAILURE_MIN_SAMPLES=250
MULTI_TENANT_PARSE_FAILURE_WINDOW=2000
ONLINE_UPDATE_INTERVAL=500
ONLINE_UPDATE_ENABLED=true
TEACHER_ESCALATION_ENABLED=true
ESCALATION_ENTROPY_THRESHOLD=0.85
ESCALATION_UNKNOWN_RATIO_THRESHOLD=0.3
ESCALATION_MAX_RATE=0.15

# Fluent Bit / shipper examples
LOGGUARD_BASE_URL=http://localhost:8000
LOGGUARD_ENDPOINT=http://localhost:8000/api/v1/logs/agent/send-logs
LOGGUARD_PROJECT_API_KEY=replace-with-project-ingest-api-key

# Scripts and integration tests
TEST_BASE_URL=http://localhost:8000
TEST_API_KEY=
TEST_TIMEOUT=15
TEST_APP_URL=http://localhost:3000
TEST_BACKEND_API=http://localhost:8000
TEST_WS_URL=ws://localhost:8000/ws
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASS=
TEST_MANAGER_EMAIL=
TEST_MANAGER_PASS=
FIREBASE_API_KEY=
SAAS_API_KEY=
PLAYGROUND_API_KEY=
SAAS_SITE_URL=http://saas-starter.local
PLAYGROUND_SITE_URL=http://playground.local
STRESS_MAX_PHASE=3
STRESS_DRY_RUN=1
WAIT_TIMEOUT=15
ANOMALY_SERVICE_URL=http://localhost:8001
ANOMALY_ADMIN_KEY=
DETECTOR_STORAGE_DIR=./data/detector
LOG_GENERATOR_BASE_URL=http://localhost:8000
ATTACK_TEST_BASE_URL=http://localhost:8000

# Sonar report utility
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=
